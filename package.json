{
  "name": "drugctl",
  "version": "0.1.0",
  "description": "CLI for tracking drug inventory across government health institutions.",
  "type": "module",
  "bin": {
    "drugctl": "./bin/drugctl.js"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:check": "node src/db/check.js",
    "migrate": "node src/db/migrate.js",
    "dev": "node bin/drugctl.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  }
}
